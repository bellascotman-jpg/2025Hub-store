{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "2025hub-store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "2025hub-store",
      "database_id": "2cf7f733-6689-4e0a-bd19-ce84bb60172d",
      "migrations_dir": "migrations"
    }
  ]
}
